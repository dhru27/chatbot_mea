# Supabase configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# CORS settings (comma-separated list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","https://your-netlify-app.netlify.app"]

# Admin API key for protected endpoints
ADMIN_API_KEY=your-strong-secret-key

# File uploads
STORAGE_BUCKET=uploads 

# Chatbot provider: "openai" or "anthropic"
CHATBOT_PROVIDER=openai

# OpenAI chatbot (used when CHATBOT_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=900

# Anthropic / Claude chatbot (used when CHATBOT_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=900

# Optional: override where markdown knowledge files are loaded from.
# CHATBOT_KNOWLEDGE_DIR=/absolute/path/to/chatbot/knowledge